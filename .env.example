# Copy to .env and fill in. Never commit .env.

# ── Images ─────────────────────────────────────────────────────────
# Pick ONE image provider. sangtao = cheapest for many images: plans from ~200k VND / 500 images, 20 reference images per image.
# API calls need a plan or credit. Pricing: https://sangtao.ai/vi/imagine?tab=pricing
# Get a key: https://sangtao.ai  ·  Docs: https://sangtao.ai/vi/api-docs/chatgpt-image
IMAGE_PROVIDER=sangtao
SANGTAO_API_KEY=
# SANGTAO_RESOLUTION=2K

# or OpenAI Images
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# ── Voice ──────────────────────────────────────────────────────────
TTS_PROVIDER=vbee
VBEE_APP_ID=
VBEE_TOKEN=
# VBEE_VOICE=n_hn_male_ngankechuyen_ytstable_vc
# VBEE_SPEED=1.1

# or ElevenLabs (exact word timing for captions)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_LANGUAGE=vi

# ── Tools ──────────────────────────────────────────────────────────
# FFMPEG_PATH=/usr/local/bin/ffmpeg
